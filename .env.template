# Copy this file to .env.local (gitignored) and fill in real values.
# Loaded automatically by Spring at startup (see spring.config.import in application.properties).
# .env.local takes priority over .env if both exist.

# --- Security / JWT (required in staging/prod; the dev profile has a local-only fallback) ---
# Base64, min 256 bits. Generate with: openssl rand -base64 32
JWT_SECRET=

# --- Datasource (required for staging/prod profiles) ---
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# --- CORS (required for prod profile) ---
CORS_ALLOWED_ORIGIN=

# --- Email notifications (optional: blank SMTP_HOST disables real sending, see EmailNotificationChannel) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# --- Documents (required for staging/prod profiles) ---
# Where uploaded client documents are written (encrypted), and the AES-256 key used to encrypt them.
# Key: base64 of 32 random bytes, generate with: openssl rand -base64 32. Startup fails without it in
# staging/prod; optional in dev (documents are then stored in clear, with a warning at startup).
DOCUMENT_STORAGE_PATH=
DOCUMENT_ENCRYPTION_KEY=
# Antivirus (ClamAV) used on every upload
CLAMAV_HOST=
CLAMAV_PORT=3310
# Bulk Excel import: temporary storage (files are deleted when the import job ends)
DEMAND_IMPORT_STORAGE_PATH=./data/demand-imports

# --- Payments ---
# The account clients transfer their installments into. Must be a valid Moroccan RIB
# (24 digits, key checked at startup). The default below is a test RIB: replace it in staging/prod.
PAYMENT_BENEFICIARY_NAME=Credit Bladi SA
PAYMENT_BENEFICIARY_RIB=230 780 0123456789012345 03

# --- Regulatory and servicing rules (validated defaults) ---
# Legal maximum interest rate (TMIC, Bank Al-Maghrib), in %. Review every semester.
MAX_ANNUAL_RATE=14.00
# Late interest = installment x (credit rate + this margin) x days late / 360
LATE_INTEREST_MARGIN_POINTS=2.00

# --- SMS (optional) ---
# mailpit (default, SMS delivered to the local Mailpit inbox) | http (real aggregator)
SMS_GATEWAY_PROVIDER=mailpit
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER_ID=CreditBladi

# --- BAM / SCIP / Centrale des Risques verification (optional) ---
# mock (default, simulated results) | real (requires a contracted provider)
BAM_VERIFICATION_PROVIDER=mock
BAM_VERIFICATION_GATEWAY_URL=
BAM_VERIFICATION_GATEWAY_API_KEY=
