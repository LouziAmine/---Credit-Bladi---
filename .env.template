# Copy this file to .env.local (gitignored) and fill in real values.
# Loaded automatically by Spring at startup (see spring.config.import in application.properties).
# .env.local takes priority over .env if both exist.

# --- Security / JWT (required in every profile, no default in source) ---
# Base64, min 256 bits. Generate with: openssl rand -base64 32
JWT_SECRET=

# --- Datasource (required for staging/prod profiles) ---
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# --- CORS (required for prod profile) ---
CORS_ALLOWED_ORIGIN=