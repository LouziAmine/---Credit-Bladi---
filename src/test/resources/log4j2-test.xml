<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">

    <Appenders>
        <Console name="CONSOLE" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%-5level] %logger{15} - %msg%n%xEx"/>
        </Console>
    </Appenders>

    <Loggers>
        <Logger name="com.credit.bladi" level="INFO" additivity="false">
            <AppenderRef ref="CONSOLE"/>
        </Logger>

        <Root level="WARN">
            <AppenderRef ref="CONSOLE"/>
        </Root>
    </Loggers>

</Configuration>